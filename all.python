#!/usr/bin/env python3
"""
all.python — FPL squad plan (team 1512229, GW4)

Prints a 15-pick plan. ``--apply`` does not write by itself. A write is sent
only by ``fpl_skill.execution.execute_account_mutation`` after every gate
passes:

* explicit per-change ``--approval`` token bound to this exact payload
* ``FPL_MODE`` of ``approval`` or ``autonomous`` (``autonomous`` does not skip the token)
* account ownership state ``VERIFIED_CURRENT``
* sandbox validation (budget, 2/5/5/3, max 3 per club, legal XI, captain and vice in the XI)

The bundled plan stores lineup slots only. It has no club, price, or playing
position, so the sandbox rejects it and no request is sent. Missing or
invalid approval raises before cookies are read and before any HTTP call.

Usage:
    python3 all.python                          # dry-run (prints plan)
    python3 all.python --apply --cookies ~/.fpl_cookies.txt --approval APPROVE:<digest>
"""
import argparse, json, os, sys, urllib.request, urllib.error

TEAM_ID = "1512229"
GW      = 4

# Recommended GW4 state (GOAT analysis, live API data)
TRANSFER_IN  = {"element": 427, "web_name": "Mbeumo"}   # Man Utd MID 7.9
TRANSFER_OUT = {"element": 399, "web_name": "Cherki"}   # Man City MID 7.8

# Full 15 after the transfer: (element, web_name, position)
SQUAD = [
    (109, "Verbruggen",   1),   # GK
    (115, "De Cuyper",    2),   # DEF
    (8,   "Calafiori",    3),   # DEF
    (388, "Guéhi",        4),   # DEF
    (426, "B.Fernandes",  5),   # MID
    (427, "Mbeumo",       6),   # MID  <- transfer in
    (367, "Gakpo",        7),   # MID
    (124, "Groß",         8),   # MID
    (165, "João Pedro",   9),   # FWD  CAPTAIN
    (411, "Haaland",     10),   # FWD
    (249, "Barry",       11),   # FWD
    (565, "M.Sangaré",   12),   # bench 1
    (279, "Ajayi",       13),   # bench 2
    (277, "Egan",        14),   # bench 3
    (572, "Tzolakis",    15),   # bench 4 (GK last)
]
CAPTAIN = 165
VICE    = 426
CHIP    = None          # wildcard used GW3; save the rest

def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true", help="attempt a gated write (still fails closed without approval)")
    ap.add_argument("--cookies", default=os.environ.get("FPL_COOKIES_FILE"), help="Netscape cookie dump from a logged-in browser")
    ap.add_argument("--approval", default=None, help="per-change APPROVE:<digest> token for this exact payload")
    args = ap.parse_args(argv)

    plan = build_plan()
    print(json.dumps(plan, indent=1))

    if not args.apply:
        print("\n[DRY-RUN] Nothing written. Re-run with --apply only after the approval gate, sandbox, and verified account state all pass.")
        return 0

    from fpl_skill.approval_gate import ExecutionDenied
    from fpl_skill.execution import execute_account_mutation

    payload = {"chip": CHIP, "picks": plan["picks"]}
    endpoint = f"/my-team/{TEAM_ID}/"
    try:
        result = execute_account_mutation(
            team_id=TEAM_ID,
            endpoint=endpoint,
            payload=payload,
            picks=plan["picks"],
            approval_token=args.approval,
            mode=os.environ.get("FPL_MODE"),
            state_provider=_ownership_state,
            transport=_build_transport(args.cookies),
        )
    except ExecutionDenied as exc:
        print(f"\n[BLOCKED] {exc}")
        return 1

    status = result.get("status") if isinstance(result, dict) else None
    print(f"\n[save] POST /api/my-team/{TEAM_ID}/ status={status}")
    if isinstance(status, int) and status < 400:
        print(f"\n[DONE] Transfer ({TRANSFER_OUT['web_name']} OUT -> {TRANSFER_IN['web_name']} IN) "
              f"+ lineup + captain/vice applied for GW{GW}. Verify: https://fantasy.premierleague.com/my-team")
        return 0
    body = result.get("body", "") if isinstance(result, dict) else ""
    print(f"[BODY] {body[:500]}")
    print("[ERROR] Save rejected. Re-export fresh cookies and retry.")
    return 1

def build_plan():
    picks = []
    for element, name, pos in SQUAD:
        picks.append({
            "element": element,
            "position": pos,
            "is_captain": element == CAPTAIN,
            "is_vice_captain": element == VICE,
        })
    return {"chip": CHIP, "picks": picks}

def load_cookies(path):
    if not path:
        return None, None
    try:
        txt = open(path, "r", encoding="utf-8", errors="replace").read()
    except OSError:
        return None, None
    csrf = None
    pairs = []
    for line in txt.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) >= 7:
            name, value = parts[5], parts[6]
            pairs.append((name, value))
            if name == "csrftoken":
                csrf = value
    if not pairs:
        return None, None
    return csrf, " ".join(f"{n}={v}" for n, v in pairs)

def _ownership_state():
    from fpl_skill.account_adapter import FPLAccountAdapter

    adapter = FPLAccountAdapter(TEAM_ID)
    state = adapter.get_state(GW)
    return state.get("ownership_state")

def _build_transport(cookie_path):
    from fpl_skill.approval_gate import ExecutionDenied

    def transport(endpoint, payload):
        csrf, jar = load_cookies(cookie_path)
        if not csrf or not jar:
            raise ExecutionDenied(
                "cookies must contain csrftoken and a session cookie; nothing was sent"
            )
        return _api_post(jar, csrf, endpoint, payload)

    return transport

def _api_post(jar, csrf, endpoint, payload):
    from fpl_skill.approval_gate import ExecutionDenied
    from fpl_skill.execution import TRANSPORT_ARMED

    if not TRANSPORT_ARMED.get():
        raise ExecutionDenied("direct POST refused; writes must go through execute_account_mutation")
    req = urllib.request.Request(
        "https://fantasy.premierleague.com/api" + endpoint,
        data=json.dumps(payload).encode(),
        headers={
            "Cookie": jar,
            "Content-Type": "application/json",
            "X-CSRFToken": csrf,
            "User-Agent": "Mozilla/5.0",
        },
        method="POST")
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return {"status": r.status, "body": r.read().decode()[:500]}
    except urllib.error.HTTPError as e:
        return {"status": e.code, "body": e.read().decode()[:500]}

if __name__ == "__main__":
    sys.exit(main())
