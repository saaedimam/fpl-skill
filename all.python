#!/usr/bin/env python3
"""
all.python — print an FPL squad plan. This file never writes.

The team id comes from ``FPL_TEAM_ID``. If that variable is missing the
script stops. ``--apply``, a cookie file, and a signed approval cannot
transmit a change. ``execute_account_mutation`` refuses every account
mutation before any outbound request.

Usage:
    FPL_TEAM_ID=YOUR_ENTRY_ID python3 all.python
"""
import argparse, json, os, sys

GW = 4

# Illustrative plan only. Player ids are public element ids, not an account.
TRANSFER_IN  = {"element": 427, "web_name": "Mbeumo"}
TRANSFER_OUT = {"element": 399, "web_name": "Cherki"}

# Full 15 after the transfer: (element, web_name, lineup slot)
SQUAD = [
    (109, "Verbruggen",   1),
    (115, "De Cuyper",    2),
    (8,   "Calafiori",    3),
    (388, "Guéhi",        4),
    (426, "B.Fernandes",  5),
    (427, "Mbeumo",       6),
    (367, "Gakpo",        7),
    (124, "Groß",         8),
    (165, "João Pedro",   9),
    (411, "Haaland",     10),
    (249, "Barry",       11),
    (565, "M.Sangaré",   12),
    (279, "Ajayi",       13),
    (277, "Egan",        14),
    (572, "Tzolakis",    15),
]
CAPTAIN = 165
VICE    = 426
CHIP    = None

def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument(
        "--apply",
        action="store_true",
        help="deprecated: account mutations are permanently disabled and nothing is transmitted",
    )
    ap.add_argument(
        "--cookies",
        default=os.environ.get("FPL_COOKIES_FILE"),
        help="deprecated: cookie files are not read and cannot authorize a write",
    )
    ap.add_argument("--approval-file", default=None, help="JSON approval record from python -m fpl_skill.approval_issuer")
    args = ap.parse_args(argv)

    team_id = os.environ.get("FPL_TEAM_ID", "").strip()
    if not team_id:
        print("\n[BLOCKED] FPL_TEAM_ID is not set. Nothing was written.")
        return 1

    plan = build_plan()
    print(json.dumps(plan, indent=1))

    if args.apply or args.cookies:
        print(
            "\n[DEPRECATED] --apply and --cookies are not a write path. "
            "Account mutations are permanently disabled."
        )

    if not args.apply:
        print("\n[DRY-RUN] Nothing written. Account mutations are not transmitted.")
        return 0

    if not args.approval_file:
        print("\n[BLOCKED] --approval-file is required. This script cannot sign its own approval.")
        return 1

    from fpl_skill.approval_gate import ExecutionDenied
    from fpl_skill.execution import execute_account_mutation

    try:
        approval = json.loads(open(args.approval_file, "r", encoding="utf-8").read())
    except (OSError, json.JSONDecodeError):
        print("\n[BLOCKED] Approval file could not be read.")
        return 1

    payload = {"chip": CHIP, "picks": plan["picks"]}
    endpoint = f"/my-team/{team_id}/"
    try:
        execute_account_mutation(
            team_id=team_id,
            endpoint=endpoint,
            payload=payload,
            picks=plan["picks"],
            approval=approval,
            mode=os.environ.get("FPL_MODE"),
            transport=_build_transport(args.cookies),
        )
    except ExecutionDenied as exc:
        print(f"\n[BLOCKED] {exc}")
        return 1

    print("\n[BLOCKED] live writes are disabled. Nothing was transmitted.")
    return 1

def build_plan():
    picks = []
    for element, name, pos in SQUAD:
        picks.append({
            "element": element,
            "position": pos,
            "is_captain": element == CAPTAIN,
            "is_vice_captain": element == VICE,
        })
    return {"chip": CHIP, "picks": picks}

def load_cookies(path):
    """Cookie files are not read for transmission. Kept so old flags fail closed."""
    return None, None

def _build_transport(cookie_path):
    from fpl_skill.approval_gate import ExecutionDenied

    def transport(endpoint, payload):
        raise ExecutionDenied(
            "live writes are disabled; a signed approval does not authorize transmission"
        )

    return transport

def _api_post(jar, csrf, endpoint, payload):
    from fpl_skill.approval_gate import ExecutionDenied

    raise ExecutionDenied("direct POST refused; live writes are disabled")

if __name__ == "__main__":
    sys.exit(main())
